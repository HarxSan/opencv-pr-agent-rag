# Copy to .env and fill in. setup.sh fills the two empty keys marked (auto).

# GitHub: a token with Contents (read), Issues and Pull requests (read and write)
GITHUB_USER_TOKEN=
# Shared secret set on the GitHub webhook. The server refuses webhooks without it. (auto)
GITHUB_WEBHOOK_SECRET=
# Required to use POST /test and POST /context (sent as the X-Admin-Token header). Unset = those routes return 404.
ADMIN_TOKEN=

# Model server (OpenAI-compatible base address). Required, there is no default.
LIGHTNING_AI_ENDPOINT=
LIGHTNING_AI_MODEL_NAME=nareshmlx/code-reviewer-opencv-harxsan-v2
LIGHTNING_AI_API_KEY=not-used

# Local OpenCV clone used by the indexer
OPENCV_REPO_PATH=

# Qdrant (auto)
QDRANT_API_KEY=
